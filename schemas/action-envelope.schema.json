{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/schemas/action-envelope.schema.json",
  "title": "RACS Action Envelope",
  "type": "object",
  "required": [
    "racs_version",
    "action_id",
    "action_type",
    "actor",
    "target",
    "requested_effect",
    "authority_context",
    "policy_context",
    "evidence_package",
    "environment_state",
    "created_at"
  ],
  "properties": {
    "racs_version": { "type": "string" },
    "action_id": { "type": "string", "minLength": 1 },
    "action_type": { "type": "string", "minLength": 1 },
    "actor": { "type": "object" },
    "target": { "type": "object" },
    "requested_effect": { "type": "object" },
    "authority_context": { "type": "object" },
    "policy_context": { "type": "object" },
    "evidence_package": { "type": "object" },
    "environment_state": { "type": "object" },
    "risk_context": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}