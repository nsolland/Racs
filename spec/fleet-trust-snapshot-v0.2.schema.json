{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://racs.dev/spec/fleet-trust-snapshot-v0.2.schema.json","title":"FleetTrustSnapshot","type":"object","additionalProperties":false,"required":["snapshot_id","tenant_id","policy_id","policy_version","policy_digest","component_count","full_count","constrained_count","suspended_count","stale_count","component_state_digest","observed_at","previous_snapshot_hash"],"properties":{"snapshot_id":{"type":"string","minLength":1},"tenant_id":{"type":"string","minLength":1},"policy_id":{"type":"string","minLength":1},"policy_version":{"type":"integer","minimum":1},"policy_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"component_count":{"type":"integer","minimum":1},"full_count":{"type":"integer","minimum":0},"constrained_count":{"type":"integer","minimum":0},"suspended_count":{"type":"integer","minimum":0},"stale_count":{"type":"integer","minimum":0},"component_state_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"observed_at":{"type":"string","format":"date-time"},"previous_snapshot_hash":{"type":["string","null"]}}}