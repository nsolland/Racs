{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/retention-policy-v0.2.schema.json",
  "title": "RACS RetentionPolicyArtifact v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retention_policy_id", "tenant_id", "policy_version", "subject_type",
    "retention_duration_seconds", "effective_from", "revocation_registry_ref",
    "legal_basis_refs", "policy_owner_id", "previous_policy_digest"
  ],
  "properties": {
    "retention_policy_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "subject_type": {"type": "string", "enum": ["AUDITOR_PACKAGE", "EXECUTION_DOSSIER", "DISCLOSURE_DOSSIER", "OTHER"]},
    "retention_duration_seconds": {"type": "integer", "minimum": 0},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": ["string", "null"], "format": "date-time"},
    "revocation_registry_ref": {"type": "string", "minLength": 1},
    "legal_basis_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "policy_owner_id": {"type": "string", "minLength": 1},
    "previous_policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "deletion_method": {"type": "string", "enum": ["CRYPTOGRAPHIC_ERASURE", "PHYSICAL_DELETION", "NONE"]}
  }
}
