{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/authority-control-exposure-assessment-v0.2.schema.json",
  "title": "AuthorityControlExposureAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","assessment_id","tenant_id","attestation_id","registry_id","registry_digest","exposure_level","foreign_control_dependencies","unresolved_authority_refs","assessed_at"],
  "properties": {
    "artifact_type": {"const": "AUTHORITY_CONTROL_EXPOSURE_ASSESSMENT"},
    "assessment_id": {"type": "string","minLength": 1},
    "tenant_id": {"type": "string","minLength": 1},
    "attestation_id": {"type": "string","minLength": 1},
    "registry_id": {"type": "string","minLength": 1},
    "registry_digest": {"type": "string","pattern": "^[a-f0-9]{64}$"},
    "exposure_level": {"enum": ["ACCEPTABLE","ELEVATED","HIGH","SYSTEMIC","INDETERMINATE"]},
    "foreign_control_dependencies": {"type": "array","items": {"type": "string"},"uniqueItems": true},
    "unresolved_authority_refs": {"type": "array","items": {"type": "string"},"uniqueItems": true},
    "rebinding_required": {"type": "boolean"},
    "assessed_at": {"type": "string","format": "date-time"}
  }
}