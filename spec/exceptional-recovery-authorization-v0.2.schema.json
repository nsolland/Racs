{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/exceptional-recovery-authorization-v0.2.schema.json",
  "title": "ExceptionalRecoveryAuthorization payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["recovery_authorization_id","tenant_id","evidence_set_id","evidence_set_digest","failed_renewal_id","failure_state","incident_id","reason_code","quorum_policy_id","required_approvals","approvals","reconstruction_scope","valid_from","valid_until","revocation_registry_ref"],
  "properties": {
    "recovery_authorization_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "evidence_set_id": {"type":"string","minLength":1},
    "evidence_set_digest": {"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},
    "failed_renewal_id": {"type":"string","minLength":1},
    "failure_state": {"enum":["AT_RISK","EXPIRED"]},
    "incident_id": {"type":"string","minLength":1},
    "reason_code": {"type":"string","minLength":1},
    "quorum_policy_id": {"type":"string","minLength":1},
    "required_approvals": {"type":"integer","minimum":2},
    "approvals": {"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["approver_id","authority_ref","decision","approved_at","signature_ref"],"properties":{"approver_id":{"type":"string","minLength":1},"authority_ref":{"type":"string","minLength":1},"decision":{"const":"APPROVE"},"approved_at":{"type":"string","format":"date-time"},"signature_ref":{"type":"string","minLength":1}}}},
    "reconstruction_scope": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "valid_from": {"type":"string","format":"date-time"},
    "valid_until": {"type":"string","format":"date-time"},
    "revocation_registry_ref": {"type":"string","minLength":1}
  }
}
