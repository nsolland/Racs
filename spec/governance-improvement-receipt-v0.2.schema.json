{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/governance-improvement-receipt-v0.2.schema.json",
  "title": "RACS GovernanceImprovementReceipt Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["governance_improvement_receipt_id", "tenant_id", "incident_id", "post_incident_review_id", "corrective_action_commitment_ids", "control_effectiveness_verification_ids", "recurrence_monitoring_plan_id", "improvement_state", "closed_at", "previous_receipt_hash"],
  "properties": {
    "governance_improvement_receipt_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "post_incident_review_id": {"type": "string", "minLength": 1},
    "corrective_action_commitment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "control_effectiveness_verification_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recurrence_monitoring_plan_id": {"type": "string", "minLength": 1},
    "improvement_state": {"enum": ["VERIFIED_EFFECTIVE", "VERIFIED_PARTIAL", "NOT_EFFECTIVE", "MONITORING_REQUIRED"]},
    "closed_at": {"type": "string", "format": "date-time"},
    "previous_receipt_hash": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"}
  }
}