{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/organizational-control-update-v0.2.schema.json",
  "title": "ORGANIZATIONAL_CONTROL_UPDATE payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["control_update_id", "tenant_id", "governance_improvement_receipt_id", "governance_improvement_receipt_digest", "control_id", "previous_control_version", "new_control_version", "change_summary", "affected_policy_refs", "effective_from", "rollout_deadline", "owner_id", "revocation_registry_ref"],
  "properties": {
    "control_update_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "governance_improvement_receipt_id": {"type": "string", "minLength": 1},
    "governance_improvement_receipt_digest": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "control_id": {"type": "string", "minLength": 1},
    "previous_control_version": {"type": "integer", "minimum": 0},
    "new_control_version": {"type": "integer", "minimum": 1},
    "change_summary": {"type": "string", "minLength": 1},
    "affected_policy_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "effective_from": {"type": "string", "format": "date-time"},
    "rollout_deadline": {"type": "string", "format": "date-time"},
    "owner_id": {"type": "string", "minLength": 1},
    "revocation_registry_ref": {"type": "string", "minLength": 1}
  }
}