{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://racs.dev/schema/0.2/delegation-chain.schema.json",
  "title":"RACS DelegationChain Payload",
  "type":"object",
  "additionalProperties":false,
  "required":["chain_id","tenant_id","root_grant_ref","links","chain_digest","valid_from","valid_until","revocation_registry_ref"],
  "properties":{
    "chain_id":{"type":"string","minLength":1},
    "tenant_id":{"type":"string","minLength":1},
    "root_grant_ref":{"type":"string","minLength":1},
    "links":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/link"}},
    "chain_digest":{"$ref":"#/$defs/digest"},
    "valid_from":{"type":"string","format":"date-time"},
    "valid_until":{"type":"string","format":"date-time"},
    "revocation_registry_ref":{"type":"string","minLength":1}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "link":{
      "type":"object",
      "additionalProperties":false,
      "required":["delegation_id","parent_ref","delegator_id","delegate_id","narrowed_scope","purpose_ref","mandate_ref","sequence","valid_from","valid_until","subdelegation_allowed","revocation_ref"],
      "properties":{
        "delegation_id":{"type":"string","minLength":1},
        "parent_ref":{"type":"string","minLength":1},
        "delegator_id":{"type":"string","minLength":1},
        "delegate_id":{"type":"string","minLength":1},
        "narrowed_scope":{"type":"object"},
        "purpose_ref":{"type":"string","minLength":1},
        "mandate_ref":{"type":"string","minLength":1},
        "sequence":{"type":"integer","minimum":0},
        "valid_from":{"type":"string","format":"date-time"},
        "valid_until":{"type":"string","format":"date-time"},
        "subdelegation_allowed":{"type":"boolean"},
        "revocation_ref":{"type":"string","minLength":1}
      }
    }
  }
}