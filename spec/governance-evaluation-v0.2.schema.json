{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/schema/0.2/governance-evaluation.schema.json",
  "title": "RACS GovernanceEvaluation Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "action_id",
    "action_envelope_digest",
    "tenant_id",
    "evaluator_id",
    "evaluator_version",
    "decision",
    "authority_status",
    "policy_status",
    "evidence_status",
    "purpose_status",
    "state_status",
    "risk_status",
    "boundary_assessment_binding",
    "evaluated_at",
    "valid_until"
  ],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "action_envelope_digest": {"$ref": "#/$defs/digest"},
    "tenant_id": {"type": "string", "minLength": 1},
    "evaluator_id": {"type": "string", "minLength": 1},
    "evaluator_version": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["ALLOW", "MODIFY", "DEFER", "DENY", "STEP_UP", "HALT"]},
    "authority_status": {"$ref": "#/$defs/status"},
    "policy_status": {"$ref": "#/$defs/status"},
    "evidence_status": {"$ref": "#/$defs/status"},
    "purpose_status": {"$ref": "#/$defs/status"},
    "state_status": {"$ref": "#/$defs/status"},
    "risk_status": {"$ref": "#/$defs/status"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "object"},
    "boundary_assessment_binding": {"$ref": "#/$defs/boundary_assessment_binding"},
    "reasoning_authority": {
      "type": "boolean",
      "const": false,
      "description": "Explicit declaration of the invariant that model-generated reasoning is never authority for clearance."
    },
    "reasoning_trace_binding": {"$ref": "#/$defs/reasoning_trace_binding"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"authority_status": {"const": "MISSING"}},
        "required": ["authority_status"]
      },
      "then": {
        "properties": {"decision": {"enum": ["DENY", "HALT"]}}
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {
      "type": "string",
      "enum": ["PRESENT_AND_VALID", "PRESENT_BUT_INVALID", "MISSING", "UNKNOWN", "UNAVAILABLE", "STALE", "REVOKED", "CONFLICTING"]
    },
    "boundary_assessment_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_ref", "assessment_digest"],
      "properties": {
        "assessment_ref": {"type": "string", "minLength": 1},
        "assessment_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "reasoning_trace_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative_for_clearance", "trace_completeness"],
      "properties": {
        "authoritative_for_clearance": {"type": "boolean", "const": false},
        "trace_completeness": {
          "type": "string",
          "enum": ["FULL_VISIBLE_CONTEXT", "PARTIAL_VISIBLE_CONTEXT", "UNAVAILABLE", "UNKNOWN"]
        },
        "model_context_digest": {"$ref": "#/$defs/digest"},
        "prefill_digest": {"$ref": "#/$defs/digest"},
        "model_config_digest": {"$ref": "#/$defs/digest"},
        "generated_token_ranges_digest": {"$ref": "#/$defs/digest"},
        "trace_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
