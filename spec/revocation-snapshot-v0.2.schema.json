{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/revocation-snapshot-v0.2.schema.json",
  "title": "RACS RevocationSnapshot Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["revocation_snapshot_id","tenant_id","registry_id","registry_version","previous_snapshot_digest","effective_at","next_update_at","revoked_artifacts","revoked_keys","reason_codes"],
  "properties": {
    "revocation_snapshot_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "registry_id": {"type":"string","minLength":1},
    "registry_version": {"type":"integer","minimum":1},
    "previous_snapshot_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "effective_at": {"type":"string","format":"date-time"},
    "next_update_at": {"type":"string","format":"date-time"},
    "revoked_artifacts": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "revoked_keys": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "reason_codes": {"type":"object","additionalProperties":{"type":"string","minLength":1}}
  }
}