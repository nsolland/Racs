{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://racs.dev/schema/intervention-receipt-v0.2.schema.json","title":"InterventionReceiptV0_2","type":"object","additionalProperties":false,"required":["schema_version","intervention_id","session_id","continuity_decision_digest","intervention_type","requested_at","applied_at","executor_id","pre_state_digest","post_state_digest","result"],"properties":{"schema_version":{"const":"racs.intervention-receipt.v0.2"},"intervention_id":{"type":"string","minLength":1},"session_id":{"type":"string","minLength":1},"continuity_decision_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"intervention_type":{"enum":["MODIFY_RUNTIME_BOUNDS","PAUSE","STOP","REAUTHORIZE","ROLLBACK","HANDOVER","HALT"]},"requested_at":{"type":"string","format":"date-time"},"applied_at":{"type":"string","format":"date-time"},"executor_id":{"type":"string","minLength":1},"pre_state_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"post_state_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"result":{"enum":["APPLIED","PARTIAL","FAILED","NOT_APPLICABLE"]},"failure_reason":{"type":["string","null"],"minLength":1},"previous_receipt_digest":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"}},"allOf":[{"if":{"properties":{"result":{"enum":["PARTIAL","FAILED"]}}},"then":{"required":["failure_reason"],"properties":{"failure_reason":{"type":"string","minLength":1}}}}]}
