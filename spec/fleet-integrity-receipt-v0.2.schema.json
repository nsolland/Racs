{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://racs.dev/spec/fleet-integrity-receipt-v0.2.schema.json","title":"FleetIntegrityReceipt","type":"object","additionalProperties":false,"required":["receipt_id","tenant_id","fleet_snapshot_id","fleet_snapshot_digest","threshold_id","threshold_digest","decision","affected_component_count","safe_state_acknowledgement_refs","issued_at","previous_receipt_hash"],"properties":{"receipt_id":{"type":"string","minLength":1},"tenant_id":{"type":"string","minLength":1},"fleet_snapshot_id":{"type":"string","minLength":1},"fleet_snapshot_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"threshold_id":{"type":"string","minLength":1},"threshold_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"decision":{"enum":["NORMAL","SAFE","HALT","INDETERMINATE"]},"affected_component_count":{"type":"integer","minimum":0},"safe_state_acknowledgement_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"issued_at":{"type":"string","format":"date-time"},"previous_receipt_hash":{"type":["string","null"]}}}