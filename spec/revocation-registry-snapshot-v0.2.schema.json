{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://racs.dev/schema/0.2/revocation-registry-snapshot.schema.json","title":"RACS Revocation Registry Snapshot","description":"Canonical snapshot of the append-only revocation registry: revoked authorities, tokens and permits with a deterministic, verifiable revocation record.","type":"object","additionalProperties":false,"required":["snapshot_id","snapshot_sha256","previous_snapshot_sha256","created_at","schema_version","revocations","registry_end_sha256","issuer_id"],"properties":{"snapshot_id":{"type":"string","minLength":1},"snapshot_sha256":{"$ref":"#/$defs/digest"},"previous_snapshot_sha256":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"created_at":{"type":"string","format":"date-time"},"schema_version":{"const":"0.2"},"issuer_id":{"type":"string","minLength":1},"registry_end_sha256":{"$ref":"#/$defs/digest","description":"Digest of the full append-only registry tail, so a snapshot can be validated against the authoritative registry."},"revocations":{"type":"array","items":{"$ref":"#/$defs/revocation_record"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"revocation_record":{"type":"object","additionalProperties":false,"required":["revocation_id","subject_type","subject_ref","subject_digest","revoked_at","reason_code","authority_ref","signature"],"properties":{"revocation_id":{"type":"string","minLength":1},"subject_type":{"enum":["AUTHORITY","TOKEN","PERMIT","CLEARANCE","DETERMINATION","CAPABILITY_MANIFEST"]},"subject_ref":{"type":"string","minLength":1},"subject_digest":{"$ref":"#/$defs/digest"},"revoked_at":{"type":"string","format":"date-time"},"reason_code":{"type":"string","minLength":1},"authority_ref":{"type":"string","minLength":1},"signature":{"type":"string","minLength":1}}}}},"dependentRequired":{"previous_snapshot_sha256":["registry_end_sha256"]}}