{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/governed-model-substitution-v0.2.schema.json",
  "title": "GOVERNED_MODEL_SUBSTITUTION",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "substitution_id", "tenant_id", "assessment_id", "source_model_id", "source_model_digest", "replacement_model_id", "replacement_model_digest", "action", "scope_digest", "single_use", "valid_until"],
  "properties": {
    "artifact_type": {"const": "GOVERNED_MODEL_SUBSTITUTION"},
    "substitution_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "source_model_id": {"type": "string", "minLength": 1},
    "source_model_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replacement_model_id": {"type": "string", "minLength": 1},
    "replacement_model_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action": {"enum": ["CONSTRAIN", "SUBSTITUTE", "LOCALIZE", "SUSPEND"]},
    "scope_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "single_use": {"const": true},
    "valid_until": {"type": "string", "format": "date-time"}
  }
}