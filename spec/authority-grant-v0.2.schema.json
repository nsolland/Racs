{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://racs.dev/schema/0.2/authority-grant.schema.json",
  "title":"RACS AuthorityGrant Payload",
  "type":"object",
  "additionalProperties":false,
  "required":["grant_id","tenant_id","grantor_id","grantee_id","standing_ref","allowed_action_types","resource_scope","capability_scope","purpose_refs","delegation_allowed","max_delegation_depth","valid_from","valid_until","revocation_registry_ref"],
  "properties":{
    "grant_id":{"type":"string","minLength":1},
    "tenant_id":{"type":"string","minLength":1},
    "grantor_id":{"type":"string","minLength":1},
    "grantee_id":{"type":"string","minLength":1},
    "standing_ref":{"type":"string","minLength":1},
    "allowed_action_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "resource_scope":{"type":"object"},
    "capability_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "purpose_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "delegation_allowed":{"type":"boolean"},
    "max_delegation_depth":{"type":"integer","minimum":0},
    "valid_from":{"type":"string","format":"date-time"},
    "valid_until":{"type":"string","format":"date-time"},
    "revocation_registry_ref":{"type":"string","minLength":1}
  }
}