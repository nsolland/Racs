{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/control-effectiveness-verification-v0.2.schema.json",
  "title": "RACS ControlEffectivenessVerification Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["control_effectiveness_verification_id", "tenant_id", "incident_id", "corrective_action_commitment_id", "control_id", "verifier_id", "test_method", "evidence_refs", "result", "residual_risk", "verified_at"],
  "properties": {
    "control_effectiveness_verification_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "corrective_action_commitment_id": {"type": "string", "minLength": 1},
    "control_id": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "test_method": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result": {"enum": ["EFFECTIVE", "PARTIALLY_EFFECTIVE", "INEFFECTIVE", "INCONCLUSIVE"]},
    "residual_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "verified_at": {"type": "string", "format": "date-time"}
  }
}