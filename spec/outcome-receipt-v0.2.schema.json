{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://racs.dev/schema/0.2/outcome-receipt.schema.json","title":"RACS OutcomeReceipt Payload","type":"object","additionalProperties":false,"required":["outcome_receipt_id","execution_receipt_id","execution_receipt_digest","tenant_id","observation_window","expected_effect","observed_effect","evidence_refs","measurement_method","baseline_ref","attribution_score","confidence","dispute_state","observed_at","previous_receipt_hash"],"properties":{"outcome_receipt_id":{"type":"string","minLength":1},"execution_receipt_id":{"type":"string","minLength":1},"execution_receipt_digest":{"$ref":"#/$defs/digest"},"tenant_id":{"type":"string","minLength":1},"observation_window":{"type":"object"},"expected_effect":{"type":"object"},"observed_effect":{"type":"object"},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"measurement_method":{"type":"string","minLength":1},"baseline_ref":{"type":"string","minLength":1},"counterfactual_ref":{"type":"string"},"attribution_score":{"type":"number","minimum":0,"maximum":1},"confidence":{"type":"number","minimum":0,"maximum":1},"dispute_state":{"type":"string","enum":["UNDISPUTED","DISPUTED","RESOLVED","REVERSED"]},"observed_at":{"type":"string","format":"date-time"},"previous_receipt_hash":{"$ref":"#/$defs/digest"},"workspace_binding_digest":{"$ref":"#/$defs/digest","description":"Digest of the exact non-authoritative Kernel WorkspaceExecutionBinding."},"kernel_context_digest":{"$ref":"#/$defs/digest","description":"Digest of the exact fresh Kernel execution context accepted by REHT."}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"dependentRequired":{"workspace_binding_digest":["kernel_context_digest"],"kernel_context_digest":["workspace_binding_digest"]}}
