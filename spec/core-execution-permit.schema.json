{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/schema/0.2/core-execution-permit.schema.json",
  "title": "RACS CoreExecutionPermit Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "action_id",
    "tenant_id",
    "clearance_id",
    "clearance_digest",
    "action_envelope_digest",
    "connector_id",
    "capability",
    "target_digest",
    "payload_digest",
    "purpose_digest",
    "authority_digest",
    "policy_digest",
    "evidence_digest",
    "state_digest",
    "valid_from",
    "valid_until",
    "replay_nonce",
    "idempotency_key",
    "reservation_id"
  ],
  "properties": {
    "execution_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "clearance_id": {"type": "string", "minLength": 1},
    "clearance_digest": {"$ref": "#/$defs/digest"},
    "action_envelope_digest": {"$ref": "#/$defs/digest"},
    "connector_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "target_digest": {"$ref": "#/$defs/digest"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "purpose_digest": {"$ref": "#/$defs/digest"},
    "authority_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "replay_nonce": {"type": "string", "minLength": 16},
    "idempotency_key": {"type": "string", "minLength": 8},
    "reservation_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
