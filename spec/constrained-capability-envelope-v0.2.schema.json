{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/constrained-capability-envelope-v0.2.schema.json",
  "title": "CONSTRAINED_CAPABILITY_ENVELOPE payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_id", "tenant_id", "component_id", "allowed_capabilities", "denied_capabilities", "resource_scope", "purpose_refs", "max_actions", "max_risk_level", "human_approval_required", "valid_from", "valid_until", "revocation_registry_ref"],
  "properties": {
    "envelope_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "allowed_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "denied_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resource_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "purpose_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "max_actions": {"type": "integer", "minimum": 1},
    "max_risk_level": {"enum": ["LOW", "MEDIUM"]},
    "human_approval_required": {"type": "boolean"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "revocation_registry_ref": {"type": "string", "minLength": 1}
  }
}