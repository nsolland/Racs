{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/authority-sovereignty-receipt-v0.2.schema.json",
  "title": "AUTHORITY_SOVEREIGNTY_RECEIPT",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "tenant_id", "authority_domain", "source_identity_receipt_id", "registry_digest", "result", "unresolved_authority_refs", "issued_at", "signature"],
  "properties": {
    "artifact_type": {"const": "AUTHORITY_SOVEREIGNTY_RECEIPT"},
    "tenant_id": {"type": "string", "minLength": 1},
    "authority_domain": {"type": "string", "minLength": 1},
    "source_identity_receipt_id": {"type": "string", "minLength": 1},
    "registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result": {"enum": ["ASSURED", "CONSTRAINED", "REBOUND", "SUSPENDED", "INDETERMINATE"]},
    "unresolved_authority_refs": {"type": "array", "items": {"type": "string"}},
    "rebinding_ref": {"type": ["string", "null"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 1}
  }
}