{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/cross-incident-pattern-assessment-v0.2.schema.json",
  "title": "CrossIncidentPatternAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","schema_version","pattern_assessment_id","tenant_id","learning_extract_ids","analysis_window","pattern_class","supporting_incident_ids","confidence","systemic_relevance","evidence_refs","assessed_at"],
  "properties": {
    "artifact_type": {"const": "CROSS_INCIDENT_PATTERN_ASSESSMENT"},
    "schema_version": {"const": "0.2.0"},
    "pattern_assessment_id": {"type": "string","minLength": 1},
    "tenant_id": {"type": "string","minLength": 1},
    "learning_extract_ids": {"type": "array","minItems": 2,"uniqueItems": true,"items": {"type": "string","minLength": 1}},
    "analysis_window": {"type": "object","additionalProperties": false,"required": ["start","end"],"properties": {"start": {"type": "string","format": "date-time"},"end": {"type": "string","format": "date-time"}}},
    "pattern_class": {"type": "string","minLength": 1},
    "supporting_incident_ids": {"type": "array","minItems": 2,"uniqueItems": true,"items": {"type": "string","minLength": 1}},
    "confidence": {"type": "number","minimum": 0,"maximum": 1},
    "systemic_relevance": {"enum": ["LOW","MEDIUM","HIGH","CRITICAL"]},
    "evidence_refs": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"type": "string","minLength": 1}},
    "assessed_at": {"type": "string","format": "date-time"}
  }
}