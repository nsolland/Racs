{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/probation-monitoring-result-v0.2.schema.json",
  "title": "PROBATION_MONITORING_RESULT payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "tenant_id", "component_id", "probation_authorization_id", "observation_window", "actions_observed", "violations", "drift_events", "monitoring_outcome", "evidence_refs", "observed_at"],
  "properties": {
    "result_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "probation_authorization_id": {"type": "string", "minLength": 1},
    "observation_window": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "actions_observed": {"type": "integer", "minimum": 0},
    "violations": {"type": "integer", "minimum": 0},
    "drift_events": {"type": "integer", "minimum": 0},
    "monitoring_outcome": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}