{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/recurrence-monitoring-plan-v0.2.schema.json",
  "title": "RACS RecurrenceMonitoringPlan Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["recurrence_monitoring_plan_id", "tenant_id", "incident_id", "control_ids", "signals", "window_start", "window_end", "thresholds", "owner_id", "escalation_policy_ref"],
  "properties": {
    "recurrence_monitoring_plan_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "control_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "thresholds": {"type": "object", "minProperties": 1},
    "owner_id": {"type": "string", "minLength": 1},
    "escalation_policy_ref": {"type": "string", "minLength": 1}
  }
}