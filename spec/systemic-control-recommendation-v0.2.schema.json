{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/systemic-control-recommendation-v0.2.schema.json",
  "title": "SystemicControlRecommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","schema_version","recommendation_id","tenant_id","pattern_assessment_id","control_domain","recommended_change","affected_policy_ids","risk_reduction_claim","validation_plan","human_ratification_required","issued_at"],
  "properties": {
    "artifact_type": {"const": "SYSTEMIC_CONTROL_RECOMMENDATION"},
    "schema_version": {"const": "0.2.0"},
    "recommendation_id": {"type": "string","minLength": 1},
    "tenant_id": {"type": "string","minLength": 1},
    "pattern_assessment_id": {"type": "string","minLength": 1},
    "control_domain": {"type": "string","minLength": 1},
    "recommended_change": {"type": "string","minLength": 1},
    "affected_policy_ids": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"type": "string","minLength": 1}},
    "risk_reduction_claim": {"type": "string","minLength": 1},
    "validation_plan": {"type": "string","minLength": 1},
    "human_ratification_required": {"const": true},
    "issued_at": {"type": "string","format": "date-time"}
  }
}