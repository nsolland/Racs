{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/policy-sovereignty-receipt-v0.2.schema.json",
  "title": "POLICY_SOVEREIGNTY_RECEIPT",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "tenant_id", "source_authority_sovereignty_receipt_id", "policy_domain", "policy_set_digest", "result", "unresolved_dependencies", "evaluator_refs", "issued_at", "signature"],
  "properties": {
    "artifact_type": {"const": "POLICY_SOVEREIGNTY_RECEIPT"},
    "tenant_id": {"type": "string", "minLength": 1},
    "source_authority_sovereignty_receipt_id": {"type": "string", "minLength": 1},
    "policy_domain": {"type": "string", "minLength": 1},
    "policy_set_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "result": {"enum": ["ASSURED", "CONSTRAINED", "LOCALIZED", "SUBSTITUTED", "SUSPENDED", "INDETERMINATE"]},
    "unresolved_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evaluator_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 1}
  }
}