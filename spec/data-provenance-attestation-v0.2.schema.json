{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/data-provenance-attestation-v0.2.schema.json",
  "title": "DataProvenanceAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "attestation_id", "tenant_id", "model_sovereignty_receipt_id", "dataset_id", "dataset_digest", "lineage_graph_digest", "data_classes", "source_jurisdictions", "storage_jurisdictions", "processing_jurisdictions", "controller_ids", "processor_ids", "issued_at", "valid_until"],
  "properties": {
    "artifact_type": {"const": "DATA_PROVENANCE_ATTESTATION"},
    "attestation_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "model_sovereignty_receipt_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lineage_graph_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "storage_jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "processing_jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "controller_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "processor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "training_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "rag_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "memory_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"}
  }
}