{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/trust-bundle-v0.2.schema.json",
  "title": "RACS TrustBundle Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["trust_bundle_id","tenant_id","trust_domain","bundle_version","previous_bundle_digest","valid_from","valid_until","keys","revocation_snapshot_ref","revocation_snapshot_digest"],
  "properties": {
    "trust_bundle_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "trust_domain": {"type":"string","minLength":1},
    "bundle_version": {"type":"integer","minimum":1},
    "previous_bundle_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "valid_from": {"type":"string","format":"date-time"},
    "valid_until": {"type":"string","format":"date-time"},
    "keys": {
      "type":"array","minItems":1,"items":{
        "type":"object","additionalProperties":false,
        "required":["key_id","issuer_id","issuer_role","algorithm","public_key","status","not_before","not_after"],
        "properties":{
          "key_id":{"type":"string","minLength":1},
          "issuer_id":{"type":"string","minLength":1},
          "issuer_role":{"type":"string","minLength":1},
          "algorithm":{"const":"Ed25519"},
          "public_key":{"type":"string","minLength":40},
          "status":{"enum":["ACTIVE","RETIRED","REVOKED"]},
          "not_before":{"type":"string","format":"date-time"},
          "not_after":{"type":"string","format":"date-time"}
        }
      }
    },
    "revocation_snapshot_ref": {"type":"string","minLength":1},
    "revocation_snapshot_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}