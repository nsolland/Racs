{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/periodic-runtime-reattestation-v0.2.schema.json",
  "title": "PERIODIC_RUNTIME_REATTESTATION payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["reattestation_id", "tenant_id", "component_id", "trust_lease_id", "trust_lease_digest", "policy_id", "policy_version", "policy_digest", "software_digest", "configuration_digest", "observed_at", "valid_until", "result", "evidence_refs"],
  "properties": {
    "reattestation_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "trust_lease_id": {"type": "string", "minLength": 1},
    "trust_lease_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "software_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "configuration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "result": {"enum": ["PASS", "DRIFT", "INCONCLUSIVE"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}