{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/continuous-trust-lease-v0.2.schema.json",
  "title": "CONTINUOUS_TRUST_LEASE payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["trust_lease_id", "tenant_id", "component_id", "full_trust_restoration_receipt_id", "full_trust_restoration_receipt_digest", "policy_id", "policy_version", "policy_digest", "capability_scope", "attestation_interval_seconds", "stale_after_seconds", "valid_from", "valid_until", "revocation_registry_ref"],
  "properties": {
    "trust_lease_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "full_trust_restoration_receipt_id": {"type": "string", "minLength": 1},
    "full_trust_restoration_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attestation_interval_seconds": {"type": "integer", "minimum": 60},
    "stale_after_seconds": {"type": "integer", "minimum": 60},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "revocation_registry_ref": {"type": "string", "minLength": 1}
  }
}