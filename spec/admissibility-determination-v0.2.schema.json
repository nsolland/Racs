{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://racs.dev/schema/0.2/admissibility-determination.schema.json",
  "title":"RACS AdmissibilityDetermination Payload",
  "type":"object",
  "additionalProperties":false,
  "required":["determination_id","action_id","action_envelope_digest","tenant_id","authority_digest","delegation_chain_digest","policy_digest","evidence_digest","purpose_digest","state_digest","evaluation_bindings","state","determined_at","valid_until","revocation_registry_ref"],
  "properties":{
    "determination_id":{"type":"string","minLength":1},
    "action_id":{"type":"string","minLength":1},
    "action_envelope_digest":{"$ref":"#/$defs/digest"},
    "tenant_id":{"type":"string","minLength":1},
    "authority_digest":{"$ref":"#/$defs/digest"},
    "delegation_chain_digest":{"$ref":"#/$defs/digest"},
    "policy_digest":{"$ref":"#/$defs/digest"},
    "evidence_digest":{"$ref":"#/$defs/digest"},
    "purpose_digest":{"$ref":"#/$defs/digest"},
    "state_digest":{"$ref":"#/$defs/digest"},
    "evaluation_bindings":{
      "$ref":"#/$defs/evaluation_bindings",
      "description":"Cryptographic binding from this determination to the signed GovernanceEvaluation(s) it is based on. Each binding carries evaluation_ref (id of the GovernanceEvaluation artifact) and evaluation_digest. evaluation_digest MUST equal the SHA-256 (RACS-JCS-1 canonicalization, see CANONICALIZATION.md rule 13) over the GovernanceEvaluation payload, i.e. MUST equal that artifact's payload_digest. This is the normative definition of 'digest of the exact signed evaluation artifact': a digest over the canonicalized payload, not over any wrapper or signature."
    },
    "state": {"type": "string", "enum": ["ADMISSIBLE", "CONDITIONALLY_ADMISSIBLE", "NOT_ADMISSIBLE", "INDETERMINATE", "STALE", "REVOKED", "HALTED", "REQUIRES_STEP_UP"]},
    "conditions":{"type":"object"},
    "reason_codes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "determined_at":{"type":"string","format":"date-time"},
    "valid_until":{"type":"string","format":"date-time"},
    "revocation_registry_ref":{"type":"string","minLength":1}
  },
  "$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"evaluation_bindings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["evaluation_ref","evaluation_digest"],"properties":{"evaluation_ref":{"type":"string","minLength":1},"evaluation_digest":{"$ref":"#/$defs/digest"}}}}}
}