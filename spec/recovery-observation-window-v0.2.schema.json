{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/recovery-observation-window-v0.2.schema.json",
  "title": "RACS Recovery Observation Window Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_window_id", "tenant_id", "return_to_normal_receipt_id", "return_to_normal_receipt_digest", "fleet_id", "policy_id", "policy_version", "policy_digest", "window_start", "window_end", "required_signal_types", "minimum_sample_count", "latent_drift_threshold", "rollback_readiness_required"],
  "properties": {
    "observation_window_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "return_to_normal_receipt_id": {"type": "string", "minLength": 1},
    "return_to_normal_receipt_digest": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "fleet_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "required_signal_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "minimum_sample_count": {"type": "integer", "minimum": 1},
    "latent_drift_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "rollback_readiness_required": {"const": true}
  }
}
