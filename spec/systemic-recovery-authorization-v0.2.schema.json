{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/systemic-recovery-authorization-v0.2.schema.json",
  "title": "SystemicRecoveryAuthorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization_id", "tenant_id", "fleet_integrity_receipt_id", "safe_state", "recovery_plan_digest", "restart_stage_count", "quorum_policy_ref", "valid_from", "valid_until", "single_use"],
  "properties": {
    "authorization_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "fleet_integrity_receipt_id": {"type": "string", "minLength": 1},
    "safe_state": {"enum": ["SAFE", "HALT"]},
    "recovery_plan_digest": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "restart_stage_count": {"type": "integer", "minimum": 1},
    "quorum_policy_ref": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "single_use": {"const": true}
  }
}