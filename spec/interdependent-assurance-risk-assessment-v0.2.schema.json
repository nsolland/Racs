{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"InterdependentAssuranceRiskAssessment","type":"object","additionalProperties":false,"required":["artifact_type","assessment_id","tenant_id","snapshot_id","dependency_graph_digest","interdependence_risk","common_mode_risk","concentration_risk","risk_result","assessed_at"],"properties":{"artifact_type":{"const":"INTERDEPENDENT_ASSURANCE_RISK_ASSESSMENT"},"assessment_id":{"type":"string","minLength":1},"tenant_id":{"type":"string","minLength":1},"snapshot_id":{"type":"string","minLength":1},"dependency_graph_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"interdependence_risk":{"type":"number","minimum":0,"maximum":1},"common_mode_risk":{"type":"number","minimum":0,"maximum":1},"concentration_risk":{"type":"number","minimum":0,"maximum":1},"risk_result":{"enum":["ACCEPTABLE","ELEVATED","SYSTEMIC","INDETERMINATE"]},"affected_assurance_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"assessed_at":{"type":"string","format":"date-time"}}}