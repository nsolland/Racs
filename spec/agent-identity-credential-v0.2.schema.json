{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/schema/0.2/agent-identity-credential.schema.json",
  "title": "RACS AgentIdentityCredential Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_id", "tenant_id", "agent_id", "controller_id", "identity_key_id", "identity_key_algorithm", "identity_public_key", "agent_class", "software_digest", "runtime_attestation_ref", "valid_from", "valid_until", "revocation_registry_ref"],
  "properties": {
    "credential_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "controller_id": {"type": "string", "minLength": 1},
    "identity_key_id": {"type": "string", "minLength": 1},
    "identity_key_algorithm": {"type": "string", "enum": ["Ed25519"]},
    "identity_public_key": {"type": "string", "minLength": 40},
    "agent_class": {"type": "string", "enum": ["HUMAN_OPERATED", "SUPERVISED_AGENT", "AUTONOMOUS_AGENT", "SERVICE_AGENT"]},
    "software_digest": {"$ref": "#/$defs/digest"},
    "runtime_attestation_ref": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "revocation_registry_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
