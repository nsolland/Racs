{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/reconstruction-evidence-v0.2.schema.json",
  "title": "ReconstructionEvidence payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["reconstruction_evidence_id","tenant_id","evidence_set_id","original_evidence_set_digest","reconstructed_evidence_set_digest","recovery_authorization_id","recovery_authorization_digest","source_artifacts","reconstruction_method","independent_verifier_refs","completed_at","previous_receipt_hash"],
  "properties": {
    "reconstruction_evidence_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "evidence_set_id": {"type":"string","minLength":1},
    "original_evidence_set_digest": {"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},
    "reconstructed_evidence_set_digest": {"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},
    "recovery_authorization_id": {"type":"string","minLength":1},
    "recovery_authorization_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_artifacts": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["artifact_id","artifact_type","artifact_digest","source_ref"],"properties":{"artifact_id":{"type":"string","minLength":1},"artifact_type":{"type":"string","minLength":1},"artifact_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"source_ref":{"type":"string","minLength":1}}}},
    "reconstruction_method": {"type":"string","minLength":1},
    "independent_verifier_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "completed_at": {"type":"string","format":"date-time"},
    "previous_receipt_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
