{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/schema/0.2/governance-clearance.schema.json",
  "title": "RACS GovernanceClearance Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clearance_id",
    "action_id",
    "action_envelope_digest",
    "tenant_id",
    "decision",
    "admissibility_state",
    "authority_digest",
    "delegation_chain_digest",
    "policy_digest",
    "evidence_digest",
    "purpose_digest",
    "state_digest",
    "target_digest",
    "payload_digest",
    "connector_id",
    "capability",
    "consequence_class",
    "reversibility",
    "valid_from",
    "valid_until",
    "replay_nonce",
    "idempotency_key",
    "revocation_registry_ref",
    "evaluator_refs",
    "admissibility_determination_ref",
    "admissibility_determination_digest"
  ],
  "properties": {
    "clearance_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "action_envelope_digest": {"$ref": "#/$defs/digest"},
    "tenant_id": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["ALLOW", "MODIFY"]},
    "admissibility_state": {"type": "string", "enum": ["ADMISSIBLE", "CONDITIONALLY_ADMISSIBLE"]},
    "authority_digest": {"$ref": "#/$defs/digest"},
    "delegation_chain_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "purpose_digest": {"$ref": "#/$defs/digest"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "target_digest": {"$ref": "#/$defs/digest"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "connector_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "consequence_class": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "reversibility": {"type": "string", "enum": ["REVERSIBLE", "COMPENSATABLE", "IRREVERSIBLE"]},
    "constraints": {"$ref": "#/$defs/clearance_constraints"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "replay_nonce": {"type": "string", "minLength": 16},
    "idempotency_key": {"type": "string", "minLength": 8},
    "revocation_registry_ref": {"type": "string", "minLength": 1},
    "evaluator_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "admissibility_determination_ref": {"type": "string", "minLength": 1},
    "admissibility_determination_digest": {"$ref": "#/$defs/digest"}
  },
  "if": {
    "properties": {"decision": {"const": "MODIFY"}}
  },
  "then": {
    "required": ["constraints"],
    "properties": {
      "constraints": {"$ref": "#/$defs/clearance_constraints"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "clearance_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_readable", "binds_exact_action"],
      "properties": {
        "machine_readable": {"type": "boolean", "const": true},
        "binds_exact_action": {"type": "boolean", "const": true},
        "capability": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "payload_unchanged": {"type": "boolean"}
      }
    }
  }
}
