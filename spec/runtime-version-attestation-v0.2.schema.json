{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"RUNTIME_VERSION_ATTESTATION payload v0.2","type":"object","additionalProperties":false,"required":["attestation_id","tenant_id","component_id","component_type","software_version","software_digest","policy_id","policy_version","policy_digest","configuration_digest","attested_at","valid_until","revocation_registry_ref"],"properties":{"attestation_id":{"type":"string","minLength":1},"tenant_id":{"type":"string","minLength":1},"component_id":{"type":"string","minLength":1},"component_type":{"enum":["CONNECTOR","RUNTIME","CORE","REHT","VAIG","ORCHESTRATOR"]},"software_version":{"type":"string","minLength":1},"software_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"policy_id":{"type":"string","minLength":1},"policy_version":{"type":"integer","minimum":1},"policy_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"configuration_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"attested_at":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"revocation_registry_ref":{"type":"string","minLength":1}}}