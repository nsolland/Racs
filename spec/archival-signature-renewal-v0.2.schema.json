{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/archival-signature-renewal-v0.2.schema.json",
  "title": "RACS ArchivalSignatureRenewal Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["renewal_id", "tenant_id", "evidence_set_id", "evidence_set_digest", "previous_renewal_id", "previous_renewal_digest", "renewal_sequence", "renewed_at", "valid_until", "signature_algorithm", "digest_algorithm", "timestamp_receipt_id", "timestamp_receipt_digest", "preservation_policy_id", "previous_receipt_hash"],
  "properties": {
    "renewal_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "evidence_set_id": {"type": "string", "minLength": 1},
    "evidence_set_digest": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "previous_renewal_id": {"type": ["string", "null"]},
    "previous_renewal_digest": {"type": ["string", "null"], "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "renewal_sequence": {"type": "integer", "minimum": 1},
    "renewed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "signature_algorithm": {"type": "string", "minLength": 1},
    "digest_algorithm": {"enum": ["SHA-256", "SHA-384", "SHA-512"]},
    "timestamp_receipt_id": {"type": "string", "minLength": 1},
    "timestamp_receipt_digest": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "preservation_policy_id": {"type": "string", "minLength": 1},
    "migration_authorization_id": {"type": ["string", "null"]},
    "migration_authorization_digest": {"type": ["string", "null"], "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "previous_receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
