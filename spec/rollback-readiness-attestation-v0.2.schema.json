{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/rollback-readiness-attestation-v0.2.schema.json",
  "title": "RACS Rollback Readiness Attestation Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_id", "tenant_id", "observation_window_id", "fleet_id", "rollback_plan_id", "rollback_plan_digest", "target_safe_state", "affected_component_ids", "dependency_snapshot_digest", "control_plane_test_ref", "readiness_result", "tested_at", "valid_until"],
  "properties": {
    "attestation_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "observation_window_id": {"type": "string", "minLength": 1},
    "fleet_id": {"type": "string", "minLength": 1},
    "rollback_plan_id": {"type": "string", "minLength": 1},
    "rollback_plan_digest": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "target_safe_state": {"enum": ["SAFE", "HALT"]},
    "affected_component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependency_snapshot_digest": {"type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$"},
    "control_plane_test_ref": {"type": "string", "minLength": 1},
    "readiness_result": {"enum": ["READY", "NOT_READY", "INCONCLUSIVE"]},
    "tested_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"}
  }
}
