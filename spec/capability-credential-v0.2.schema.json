{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/schema/0.2/capability-credential.schema.json",
  "title": "RACS CapabilityCredential Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_id", "tenant_id", "agent_id", "identity_credential_id", "identity_credential_digest", "authority_grant_id", "authority_grant_digest", "delegation_chain_id", "delegation_chain_digest", "capabilities", "resource_scope", "purpose_refs", "valid_from", "valid_until", "revocation_registry_ref"],
  "properties": {
    "credential_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "identity_credential_id": {"type": "string", "minLength": 1},
    "identity_credential_digest": {"$ref": "#/$defs/digest"},
    "authority_grant_id": {"type": "string", "minLength": 1},
    "authority_grant_digest": {"$ref": "#/$defs/digest"},
    "delegation_chain_id": {"type": "string", "minLength": 1},
    "delegation_chain_digest": {"$ref": "#/$defs/digest"},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resource_scope": {"type": "object"},
    "purpose_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "revocation_registry_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
