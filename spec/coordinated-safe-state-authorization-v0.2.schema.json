{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://racs.dev/spec/coordinated-safe-state-authorization-v0.2.schema.json","title":"CoordinatedSafeStateAuthorization","type":"object","additionalProperties":false,"required":["authorization_id","tenant_id","fleet_snapshot_id","fleet_snapshot_digest","threshold_id","threshold_digest","target_state","affected_component_set_digest","reason_codes","issued_at","valid_until","single_use","idempotency_key"],"properties":{"authorization_id":{"type":"string","minLength":1},"tenant_id":{"type":"string","minLength":1},"fleet_snapshot_id":{"type":"string","minLength":1},"fleet_snapshot_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"threshold_id":{"type":"string","minLength":1},"threshold_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"target_state":{"enum":["SAFE","HALT"]},"affected_component_set_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"issued_at":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"single_use":{"const":true},"idempotency_key":{"type":"string","minLength":1}}}