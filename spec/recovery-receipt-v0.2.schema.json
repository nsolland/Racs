{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://racs.dev/schema/recovery-receipt-v0.2.schema.json","title":"RecoveryReceiptV0_2","type":"object","additionalProperties":false,"required":["schema_version","recovery_receipt_id","recovery_plan_digest","source_session_id","recovery_session_id","intervention_receipt_digest","started_at","completed_at","result","postcondition_evidence_digest","unresolved_effects","next_state"],"properties":{"schema_version":{"const":"racs.recovery-receipt.v0.2"},"recovery_receipt_id":{"type":"string","minLength":1},"recovery_plan_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"source_session_id":{"type":"string","minLength":1},"recovery_session_id":{"type":"string","minLength":1},"intervention_receipt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"started_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"},"result":{"enum":["SUCCEEDED","PARTIAL","FAILED"]},"postcondition_evidence_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"unresolved_effects":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"next_state":{"enum":["ACTIVE","PAUSED","REAUTHORIZATION_REQUIRED","COMPLETED","STOPPED","HALTED"]},"previous_receipt_digest":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"}},"allOf":[{"if":{"properties":{"result":{"const":"FAILED"}}},"then":{"properties":{"next_state":{"const":"HALTED"}}}}]}
