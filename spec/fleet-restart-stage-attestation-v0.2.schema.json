{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/fleet-restart-stage-attestation-v0.2.schema.json",
  "title": "FleetRestartStageAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_id", "tenant_id", "restart_plan_id", "stage", "component_results", "quorum_achieved", "dependency_integrity_verified", "attested_at"],
  "properties": {
    "attestation_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "restart_plan_id": {"type": "string", "minLength": 1},
    "stage": {"type": "integer", "minimum": 1},
    "component_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "state", "runtime_attestation_id", "integrity_receipt_id"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["READY", "FAILED", "INDETERMINATE"]},
          "runtime_attestation_id": {"type": "string", "minLength": 1},
          "integrity_receipt_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "quorum_achieved": {"type": "boolean"},
    "dependency_integrity_verified": {"type": "boolean"},
    "attested_at": {"type": "string", "format": "date-time"}
  }
}