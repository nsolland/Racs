{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/legal-hold-release-v0.2.schema.json",
  "title": "RACS LegalHoldRelease Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["legal_hold_release_id","tenant_id","legal_hold_authorization_id","legal_hold_authorization_digest","subject_id","subject_digest","case_ref","released_by","authority_ref","release_basis","released_at","evidence_refs","revocation_registry_ref","previous_receipt_hash"],
  "properties": {
    "legal_hold_release_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "legal_hold_authorization_id": {"type":"string","minLength":1},
    "legal_hold_authorization_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "subject_id": {"type":"string","minLength":1},
    "subject_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "case_ref": {"type":"string","minLength":1},
    "released_by": {"type":"string","minLength":1},
    "authority_ref": {"type":"string","minLength":1},
    "release_basis": {"type":"string","minLength":1},
    "released_at": {"type":"string","format":"date-time"},
    "evidence_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "revocation_registry_ref": {"type":"string","minLength":1},
    "previous_receipt_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}