{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"POLICY_ACKNOWLEDGEMENT payload v0.2","type":"object","additionalProperties":false,"required":["acknowledgement_id","tenant_id","rollout_id","policy_id","policy_version","policy_digest","component_id","component_type","acknowledged_at","effective_from","revocation_registry_ref"],"properties":{"acknowledgement_id":{"type":"string","minLength":1},"tenant_id":{"type":"string","minLength":1},"rollout_id":{"type":"string","minLength":1},"policy_id":{"type":"string","minLength":1},"policy_version":{"type":"integer","minimum":1},"policy_digest":{"type":"string","pattern":"^sha(256|384|512):[0-9a-f]+$"},"component_id":{"type":"string","minLength":1},"component_type":{"enum":["CONNECTOR","RUNTIME","CORE","REHT","VAIG","ORCHESTRATOR"]},"acknowledged_at":{"type":"string","format":"date-time"},"effective_from":{"type":"string","format":"date-time"},"revocation_registry_ref":{"type":"string","minLength":1}}}