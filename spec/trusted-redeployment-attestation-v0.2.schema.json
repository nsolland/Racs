{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/trusted-redeployment-attestation-v0.2.schema.json",
  "title": "RACS TrustedRedeploymentAttestation Payload v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["redeployment_attestation_id","tenant_id","component_id","remediation_authorization_id","remediation_authorization_digest","deployment_id","software_digest","configuration_digest","policy_id","policy_version","policy_digest","runtime_attestation_ref","runtime_attestation_digest","deployed_at","verified_at","verification_result","verifier_refs"],
  "properties": {
    "redeployment_attestation_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "component_id": {"type":"string","minLength":1},
    "remediation_authorization_id": {"type":"string","minLength":1},
    "remediation_authorization_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "deployment_id": {"type":"string","minLength":1},
    "software_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "configuration_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "policy_id": {"type":"string","minLength":1},
    "policy_version": {"type":"integer","minimum":1},
    "policy_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "runtime_attestation_ref": {"type":"string","minLength":1},
    "runtime_attestation_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "deployed_at": {"type":"string","format":"date-time"},
    "verified_at": {"type":"string","format":"date-time"},
    "verification_result": {"const":"VERIFIED"},
    "verifier_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}
  }
}