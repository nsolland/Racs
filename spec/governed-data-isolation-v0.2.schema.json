{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/spec/governed-data-isolation-v0.2.schema.json",
  "title": "GovernedDataIsolation",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "isolation_id", "tenant_id", "assessment_id", "dataset_id", "source_dataset_digest", "action", "target_data_refs", "authorization_ref", "single_use", "issued_at", "valid_until"],
  "properties": {
    "artifact_type": {"const": "GOVERNED_DATA_ISOLATION"},
    "isolation_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_dataset_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replacement_dataset_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action": {"enum": ["CONSTRAIN", "ISOLATE", "LOCALIZE", "SUBSTITUTE", "SUSPEND"]},
    "target_data_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authorization_ref": {"type": "string", "minLength": 1},
    "single_use": {"const": true},
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"}
  }
}