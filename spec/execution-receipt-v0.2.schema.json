{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racs.dev/schema/0.2/execution-receipt.schema.json",
  "title": "RACS ExecutionReceipt Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_receipt_id", "execution_id", "tenant_id", "action_id", "action_envelope_digest", "clearance_id", "clearance_digest", "commit_token_id", "commit_token_digest", "connector_id", "capability", "target_digest", "payload_digest", "started_at", "completed_at", "technical_outcome", "provider_reference", "response_digest", "reversal_status", "previous_receipt_hash"],
  "properties": {
    "execution_receipt_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "action_envelope_digest": {"$ref": "#/$defs/digest"},
    "clearance_id": {"type": "string", "minLength": 1},
    "clearance_digest": {"$ref": "#/$defs/digest"},
    "commit_token_id": {"type": "string", "minLength": 1},
    "commit_token_digest": {"$ref": "#/$defs/digest"},
    "governance_evaluation_digest": {
      "$ref": "#/$defs/digest",
      "description": "Digest of the exact GovernanceEvaluation used for clearance."
    },
    "reasoning_trace_binding_digest": {
      "$ref": "#/$defs/digest",
      "description": "Optional audit binding to the non-authoritative reasoning trace binding. It never grants authority."
    },
    "connector_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "target_digest": {"$ref": "#/$defs/digest"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "technical_outcome": {"type": "string", "enum": ["BLOCKED", "SIMULATED", "SUCCEEDED", "FAILED", "INDETERMINATE", "REVERSED"]},
    "provider_reference": {"type": "string", "minLength": 1},
    "response_digest": {"$ref": "#/$defs/digest"},
    "error_class": {"type": "string"},
    "reversal_status": {"type": "string", "enum": ["NOT_APPLICABLE", "NOT_REVERSED", "PENDING", "REVERSED", "FAILED"]},
    "previous_receipt_hash": {"$ref": "#/$defs/digest"},
    "receipt_ext": {"$ref": "#/$defs/receipt_ext"}
  },
  "dependentRequired": {
    "reasoning_trace_binding_digest": ["governance_evaluation_digest"]
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt_ext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_principal": {"type": "object"},
        "delegation_scope_ref": {"type": "string", "minLength": 1},
        "policy_fingerprint_ref": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "pre_state": {"$ref": "#/$defs/state_evidence"},
        "post_state": {"$ref": "#/$defs/state_evidence"},
        "cost": {"$ref": "#/$defs/cost_claim"},
        "value_claim": {"$ref": "#/$defs/value_claim"},
        "external_proof_ref": {"type": "string", "minLength": 1},
        "signature_binding_ref": {"type": "string", "minLength": 1},
        "replay_status": {
          "type": "string",
          "enum": ["FIRST_EXECUTION", "REPLAY", "DUPLICATE", "UNVERIFIED"]
        },
        "idempotency_token": {"type": "string", "minLength": 1},
        "duplicate_of_receipt_id": {"type": "string", "minLength": 1}
      }
    },
    "state_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scope": {"type": "string", "minLength": 1}
      },
      "required": ["evidence_ref", "scope"]
    },
    "cost_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "confidence": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "amount": {"type": "number"}
      },
      "required": ["method", "evidence_ref", "confidence"]
    },
    "value_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "confidence": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "enum": ["protected", "created", "avoided"]},
        "amount": {"type": "number"},
        "currency": {"type": "string", "minLength": 1}
      },
      "required": ["method", "evidence_ref", "confidence"]
    }
  }
}
